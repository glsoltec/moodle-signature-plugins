<?xml version="1.0" encoding="UTF-8" ?>
<XMLDB PATH="local/certificatesign/db" VERSION="20260729" COMMENT="XMLDB file for local_certificatesign">
  <TABLES>
    <TABLE NAME="local_certificatesign_log" COMMENT="Log of signed certificate issues">
      <FIELDS>
        <FIELD NAME="id"         TYPE="int"  LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="issueid"    TYPE="int"  LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="email_sent" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="email_time" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="email_attempts" TYPE="int" LENGTH="4" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="email_last_error" TYPE="char" LENGTH="255" NOTNULL="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="issueid" TYPE="unique"  FIELDS="issueid"/>
      </KEYS>
    </TABLE>
    <TABLE NAME="local_certificatesign_audit" COMMENT="Audit log for certificate access events">
      <FIELDS>
        <FIELD NAME="id"         TYPE="int"  LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="userid"     TYPE="int"  LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="issueid"    TYPE="int"  LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="cmid"       TYPE="int"  LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="courseid"   TYPE="int"  LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="action"     TYPE="char" LENGTH="20" NOTNULL="true"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="ipaddress"  TYPE="char" LENGTH="45" NOTNULL="false"/>
        <FIELD NAME="useragent"  TYPE="char" LENGTH="255" NOTNULL="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="userid"   UNIQUE="false" FIELDS="userid"/>
        <INDEX NAME="issueid"  UNIQUE="false" FIELDS="issueid"/>
        <INDEX NAME="courseid" UNIQUE="false" FIELDS="courseid"/>
      </INDEXES>
    </TABLE>
  </TABLES>
</XMLDB>
